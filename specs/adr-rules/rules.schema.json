{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADR rule revisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["ruleSchema", "rules"],
  "properties": {
    "ruleSchema": { "const": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "enum": ["local-mutation-testing", "local-ci-readiness"] },
          "replaces": { "type": "string", "pattern": "^ADR-[0-9]{3,}$" },
          "gates": true,
          "cases": true,
          "evidence": { "type": "string" }
        },
        "if": { "properties": { "id": { "const": "local-mutation-testing" } } },
        "then": {
          "required": ["gates"],
          "properties": {
            "gates": {
              "description": "Complete snapshot of gates covered by this revision.",
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
              "additionalProperties": { "enum": ["none", "full", "incremental"] }
            },
            "cases": false,
            "evidence": { "type": "string", "pattern": "^([A-Za-z0-9_-]+/)+[A-Za-z0-9_.-]+\\.test\\.(mjs|js|ts)$" }
          }
        },
        "else": {
          "required": ["cases"],
          "properties": {
            "cases": {
              "description": "Use a matching named condition, falling back to otherwise when none match.",
              "type": "object",
              "required": ["otherwise"],
              "propertyNames": { "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
              "properties": { "otherwise": { "$ref": "#/definitions/readiness" } },
              "additionalProperties": { "$ref": "#/definitions/readiness" }
            },
            "gates": false,
            "evidence": { "type": "string", "pattern": "^([A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.md#[a-z0-9]+(-[a-z0-9]+)*$" }
          }
        }
      }
    }
  },
  "definitions": { "readiness": { "enum": ["required", "may-skip"] } }
}
