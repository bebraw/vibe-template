{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local quality gate glossary",
  "type": "object",
  "required": ["gateTerms"],
  "additionalProperties": false,
  "properties": {
    "gateTerms": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["script", "definition"],
        "properties": {
          "script": { "type": "string", "pattern": "^[a-z][a-z0-9:-]*$" },
          "definition": { "type": "string", "pattern": "\\S" }
        }
      }
    }
  }
}
