{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibe-template-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
  "build": {
    "command": "npm run build:css",
    "watch_dir": "src",
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.css"],
      "fallthrough": true,
    },
  ],
}
